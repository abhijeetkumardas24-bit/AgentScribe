# Groq API Key (required for LLM reasoning and generation)
GROQ_API_KEY=your_groq_api_key_here

# Tavily API Key (optional/recommended for web research; if absent/fails, research is skipped)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Groq model name (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Deployment Port (automatically assigned by platforms like Render, Railway, Heroku)
PORT=8000
